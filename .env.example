# NCBI Entrez — strongly recommended. With a key you get 10 req/s instead of 3.
# Get one at https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
NCBI_EMAIL=you@example.com

# Optional: Upstash Redis for caching /api/expand and /api/pubmed responses
# AND for per-client (per-IP) rate limiting on the public API routes.
# Leave blank to disable both caching and rate limiting — local dev works
# fine without external deps.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Per-client rate limit (sliding window). Applied when Upstash is configured.
# Keyed on x-forwarded-for (first hop), so one noisy IP cannot exhaust the
# NCBI quota for others sharing the deployment.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW=60 s

# ── Upstream pacing (optional) ────────────────────────────────────────────────
# All outbound Entrez/Europe PMC calls pass through a token-bucket limiter
# (lib/entrez/scheduler.ts) so several requests can be in flight without
# exceeding the published rate. A token bucket admits at most
# `burst + rate` requests in any one-second window, so those two together must
# stay within the ceiling — the defaults below are chosen on that basis and
# rarely need changing.
#
# With an NCBI API key (ceiling 10 req/s): 8 + 2 = 10 worst case, 8 sustained.
# NCBI_RATE_PER_SEC=8
# NCBI_BURST=2
# NCBI_CONCURRENCY=6
#
# Without a key (ceiling 3 req/s): 2 + 1 = 3 worst case, 2 sustained.
# NCBI_RATE_PER_SEC_NO_KEY=2
# NCBI_BURST_NO_KEY=1
# NCBI_CONCURRENCY_NO_KEY=2
#
# Europe PMC (EBI) publishes no numeric limit and asks for considerate use.
# EUROPEPMC_RATE_PER_SEC=8
# EUROPEPMC_BURST=2
# EUROPEPMC_CONCURRENCY=5

# Per-request timeouts, so one hung upstream call cannot consume the whole
# serverless function budget. Leave a value blank and the built-in default is
# used; these are never read as an empty string.
# ENTREZ_TIMEOUT_MS=15000
# EUROPEPMC_TIMEOUT_MS=15000
# CACHE_TIMEOUT_MS=2000

# Ceiling on how long an upstream Retry-After is honoured. NCBI can ask for
# longer than the whole function budget, and sleeping that long guarantees the
# platform kills the request and the caller gets no body at all.
# ENTREZ_MAX_RETRY_WAIT_MS=5000

# Skip caching responses above this many bytes rather than have the write fail.
# CACHE_MAX_VALUE_BYTES=900000
